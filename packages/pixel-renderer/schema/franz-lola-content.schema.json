{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matthaeusstumptner.github.io/franz-lola/schema/franz-lola-content.schema.json",
  "title": "Franz & Lola Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "type", "id", "name", "description", "document", "dependencies"],
  "properties": {
    "kind": { "const": "franz-lola-content" },
    "schemaVersion": { "const": 1 },
    "type": { "enum": ["level", "character", "tileset", "block", "animation", "cutscene", "object"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "document": { "type": "object" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "relation"],
        "properties": {
          "type": { "enum": ["level", "character", "tileset", "block", "animation", "cutscene", "object"] },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "revision": { "type": "integer", "minimum": 1 },
          "relation": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    }
  }
}
